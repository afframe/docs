{
  "theme": "aspen",
  "name": "Afframe Docs",
  "colors": {
    "primary": "#009473",
    "light": "#28dcb1",
    "dark": "#009473"
  },
  "logo": {
    "light": "/images/horizontal.svg",
    "dark": "/images/horizontal.svg",
    "href": "https://afframe.com"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support+docs@afframe.com",
        "label": "Contact us"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Afframe",
      "href": "https://app.afframe.com/auth/login?ref=docs"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/in/afframe",
      "website": "https://afframe.com/",
      "github": "https://github.com/afframe"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf",
      "download-spec"
    ],
    "display": "header"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#1f1f1f"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Inter"
  },
  "thumbnails": {
    "fonts": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Help Center",
            "pages": [
              "help-center/welcome",
              "help-center/quickstart",
              "help-center/landing-hub",
              "help-center/kb-article",
              "help-center/api-example",
              "help-center/feature-showcase",
              "help-center/changelog",
              "help-center/callouts-demo"
            ]
          },
          {
            "tab": "Knowledge Base",
            "pages": [
              "knowledge-base/quickstart"
            ]
          },
          {
            "tab": "Developer Docs",
            "pages": [
              "developer-docs/quickstart"
            ]
          },
          {
            "tab": "API Reference",
            "pages": [
              "api-reference/quickstart"
            ]
          },
          {
            "tab": "SDKs",
            "pages": [
              "sdks/quickstart"
            ]
          },
          {
            "tab": "Enterprise",
            "pages": [
              "enterprise/quickstart"
            ]
          }
        ]
      },
      {
        "language": "cs",
        "tabs": [
          {
            "tab": "Centrum nápovědy",
            "pages": [
              "cs/help-center/quickstart"
            ]
          },
          {
            "tab": "Znalostní báze",
            "pages": [
              "cs/knowledge-base/quickstart"
            ]
          },
          {
            "tab": "Dokumentace pro vývojáře",
            "pages": [
              "cs/developer-docs/quickstart"
            ]
          },
          {
            "tab": "API reference",
            "pages": [
              "cs/api-reference/quickstart"
            ]
          },
          {
            "tab": "SDK",
            "pages": [
              "cs/sdks/quickstart"
            ]
          },
          {
            "tab": "Enterprise",
            "pages": [
              "cs/enterprise/quickstart"
            ]
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "light"
  }
}
